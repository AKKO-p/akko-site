---
import Base from '../layouts/Base.astro';
import Shot from '../components/Shot.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const catColors: Record<string, string> = {
  'Souveraineté': 'var(--cyan)',
  'Architecture': 'var(--amber)',
  'Gouvernance et IA': 'var(--violet)',
  'Actualités AKKO': 'var(--green)',
};
const fmt = (d: Date) =>
  d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' });
---
<Base
  title="AKKO · La plateforme data et IA souveraine, auto-hébergée"
  description="AKKO est une plateforme data et IA souveraine, auto-hébergée sur Kubernetes : 54 briques intégrées, lakehouse Iceberg, requêtage fédéré, IA gouvernée sous contrôle d'accès strict, déployable hors-ligne. Vos données ne quittent jamais votre infrastructure."
>
  <section class="hero">
    <div class="wrap">
      <div>
        <p class="eyebrow">AKKO</p>
        <h1>La plateforme data et IA que vous <em>hébergez et gouvernez</em> vous-même.</h1>
        <p class="sub">
          Un moteur de fédération unique, un lakehouse ouvert, une IA gouvernée. Auto-hébergée
          sur votre infrastructure : vos données ne la quittent jamais.
        </p>
        <p class="ctx">Conçue pour les organisations régulées. Banque · Santé · Secteur public.</p>
        <div class="cta">
          <a class="btn" href="mailto:contact@akko-ai.com">Nous contacter</a>
          <a class="btn ghost" href="#archi">Voir l'architecture</a>
        </div>
      </div>
      <div class="perimeter">
        <span class="plabel">Votre infrastructure</span>
        <Shot src="cockpit-home" alt="Cockpit AKKO : accueil avec ADEN, les outils et la gouvernance" eager h={906} />
        <p class="pnote">Vos données, vos modèles, vos clés. Rien ne sort.</p>
      </div>
    </div>
  </section>

  <div class="facts">
    <div class="wrap">
      <ul>
        <li>54 briques intégrées</li>
        <li>100 % auto-hébergé (Kubernetes)</li>
        <li>Formats ouverts (Iceberg)</li>
        <li>Accès gouverné (OPA)</li>
        <li>Modèles on-premises</li>
      </ul>
    </div>
  </div>


  <section class="stack" aria-label="Technologies">
    <div class="wrap">
      <p class="slabel">Construite sur des briques ouvertes et éprouvées</p>
      <ul class="logos">
        <li><img src="/logos/kubernetes.svg" alt="" width="26" height="26" loading="lazy" /><span>Kubernetes</span></li>
        <li><img src="/logos/trino.svg" alt="" width="26" height="26" loading="lazy" /><span>Trino</span></li>
        <li><img src="/logos/apachespark.svg" alt="" width="26" height="26" loading="lazy" /><span>Spark</span></li>
        <li><img src="/logos/apacheairflow.svg" alt="" width="26" height="26" loading="lazy" /><span>Airflow</span></li>
        <li><img src="/logos/apachesuperset.svg" alt="" width="26" height="26" loading="lazy" /><span>Superset</span></li>
        <li><img src="/logos/postgresql.svg" alt="" width="26" height="26" loading="lazy" /><span>PostgreSQL</span></li>
        <li><img src="/logos/jupyter.svg" alt="" width="26" height="26" loading="lazy" /><span>Jupyter</span></li>
        <li><img src="/logos/mlflow.svg" alt="" width="26" height="26" loading="lazy" /><span>MLflow</span></li>
        <li><img src="/logos/keycloak.svg" alt="" width="26" height="26" loading="lazy" /><span>Keycloak</span></li>
        <li><img src="/logos/opensearch.svg" alt="" width="26" height="26" loading="lazy" /><span>OpenSearch</span></li>
      </ul>
    </div>
  </section>

  <section class="statement">
    <div class="wrap">
      <p class="kicker" style="color:var(--cyan)">Souveraineté</p>
      <h2>La donnée appartient à votre organisation, pas à un fournisseur.</h2>
      <p class="body">
        AKKO s'installe sur votre infrastructure Kubernetes, y compris hors-ligne. Vous gardez le
        contrôle des données, des modèles, des clés et de la sortie. Aucune dépendance à un
        service externe, aucune donnée chez un tiers.
      </p>
    </div>
  </section>

  <section>
    <div class="wrap split">
      <div>
        <p class="kicker" style="color:var(--violet)">Fédération</p>
        <h2>Un seul moteur SQL sur toutes vos sources.</h2>
        <p class="body">
          Trino interroge entrepôts, fichiers et bases, ensemble, sans déplacer la donnée. Un
          lakehouse au format ouvert Iceberg, lisible par tous les moteurs. Ajout d'une source à
          chaud, depuis l'interface.
        </p>
      </div>
      <Shot src="catalog-federation" alt="Fédération de sources dans le cockpit AKKO : catalogues connectés à chaud" />
    </div>
  </section>

  <section style="padding-top:0">
    <div class="wrap split">
      <Shot src="aden-result" alt="ADEN : question en langage naturel, SQL gouverné exécuté et graphe de résultat" />
      <div>
        <p class="kicker" style="color:var(--violet)">IA gouvernée</p>
        <h2>Une IA gouvernée, sur votre infrastructure.</h2>
        <p class="body">
          ADEN traduit une question en langage naturel en SQL gouverné, l'exécute sur le
          catalogue fédéré et renvoie un graphe, avec un reçu d'audit. NORA enrichit le catalogue
          pour fonder l'IA. Les modèles tournent chez vous ; aucune donnée ne sort.
        </p>
      </div>
    </div>
  </section>

  <section style="padding-top:0">
    <div class="wrap split">
      <div>
        <p class="kicker" style="color:var(--amber)">Gouvernance</p>
        <h2>Un seul plan de contrôle des accès.</h2>
        <p class="body">
          Masquage des colonnes et filtrage des lignes par utilisateur, appliqués au moteur
          (OPA), pour chaque outil : BI, notebooks, ADEN. La gouvernance suit la donnée.
        </p>
      </div>
      <Shot src="governance-roles" alt="Gouvernance AKKO : rôles et politiques d'accès aux données" />
    </div>
  </section>

  <section class="diagram-sec" id="archi">
    <div class="wrap">
      <p class="kicker" style="color:var(--muted)">Architecture</p>
      <h2>Toute la chaîne data et IA, dans un seul cockpit.</h2>
      <p class="body">
        Stockage, lakehouse, calcul Spark, fédération Trino, catalogue avec lignage,
        orchestration, BI, lab polyglotte et IA gouvernée. 54 briques intégrées, chaque couche
        remplaçable.
      </p>
      <div class="diagram">
        <svg viewBox="0 0 980 380" width="100%" role="img" aria-label="Topologie de la plateforme AKKO">
          <defs>
            <linearGradient id="ia" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="#4f46e5"/><stop offset="1" stop-color="#0e7490"/>
            </linearGradient>
            <marker id="arw" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6.5" markerHeight="6.5" orient="auto">
              <path d="M0 0L8 4L0 8z" fill="#7d8798"/>
            </marker>
          </defs>
          <g stroke="#9aa5b5" stroke-width="1.2" fill="none" marker-end="url(#arw)">
            <path d="M120 70 H 218"/>
            <path d="M310 110 V 148"/>
            <path d="M356 70 H 448"/>
            <path d="M310 70 C 310 30 540 30 588 56"/>
            <path d="M262 110 C 240 190 160 210 132 236"/>
            <path d="M356 92 C 430 130 520 130 560 96"/>
            <path d="M540 70 H 586"/>
            <path d="M636 110 V 148"/>
            <path d="M500 110 V 236"/>
            <path d="M310 260 H 218"/>
            <path d="M820 70 C 780 40 700 40 662 56"/>
            <path d="M820 92 C 700 170 420 150 352 100"/>
          </g>
          <g font-size="12.5">
            <rect x="28" y="46" width="92" height="48" rx="10" fill="#ffffff" stroke="#b9c2d0"/>
            <text x="74" y="66" text-anchor="middle" fill="#182338">Identité</text>
            <text x="74" y="82" text-anchor="middle" fill="#7d8798" font-size="10.5">SSO OIDC</text>
            <rect x="218" y="46" width="138" height="64" rx="10" fill="rgba(79,70,229,.05)" stroke="#4f46e5" stroke-width="1.5"/>
            <text x="287" y="72" text-anchor="middle" fill="#182338" font-weight="600">Fédération SQL</text>
            <text x="287" y="90" text-anchor="middle" fill="#4d5a70" font-size="10.5">Trino</text>
            <rect x="240" y="148" width="140" height="52" rx="10" fill="rgba(180,83,9,.05)" stroke="#b45309" stroke-width="1.4"/>
            <text x="310" y="170" text-anchor="middle" fill="#182338">Contrôle d'accès</text>
            <text x="310" y="188" text-anchor="middle" fill="#4d5a70" font-size="10.5">OPA · par utilisateur</text>
            <rect x="448" y="46" width="92" height="64" rx="10" fill="rgba(180,83,9,.05)" stroke="#b45309"/>
            <text x="494" y="72" text-anchor="middle" fill="#182338">Catalogue</text>
            <text x="494" y="90" text-anchor="middle" fill="#7d8798" font-size="10.5">lignage</text>
            <rect x="588" y="46" width="96" height="64" rx="10" fill="rgba(79,70,229,.05)" stroke="url(#ia)" stroke-width="1.6"/>
            <text x="636" y="72" text-anchor="middle" fill="#182338" font-weight="600">ADEN</text>
            <text x="636" y="90" text-anchor="middle" fill="#4d5a70" font-size="10.5">NL → SQL gouverné</text>
            <rect x="576" y="148" width="120" height="52" rx="10" fill="#ffffff" stroke="url(#ia)"/>
            <text x="636" y="170" text-anchor="middle" fill="#182338">Modèles IA</text>
            <text x="636" y="188" text-anchor="middle" fill="#7d8798" font-size="10.5">on-premises</text>
            <rect x="448" y="236" width="104" height="52" rx="10" fill="rgba(180,83,9,.05)" stroke="url(#ia)"/>
            <text x="500" y="258" text-anchor="middle" fill="#182338">NORA</text>
            <text x="500" y="276" text-anchor="middle" fill="#7d8798" font-size="10.5">profilage · grounding</text>
            <rect x="28" y="236" width="104" height="52" rx="10" fill="rgba(14,116,144,.05)" stroke="#0e7490"/>
            <text x="80" y="258" text-anchor="middle" fill="#182338">Lakehouse</text>
            <text x="80" y="276" text-anchor="middle" fill="#7d8798" font-size="10.5">S3 · Iceberg</text>
            <rect x="218" y="236" width="92" height="52" rx="10" fill="rgba(79,70,229,.05)" stroke="#4f46e5"/>
            <text x="264" y="258" text-anchor="middle" fill="#182338">Calcul</text>
            <text x="264" y="276" text-anchor="middle" fill="#7d8798" font-size="10.5">Spark · Airflow</text>
            <rect x="820" y="46" width="120" height="52" rx="10" fill="rgba(4,120,87,.05)" stroke="#047857"/>
            <text x="880" y="68" text-anchor="middle" fill="#182338">BI · Notebooks</text>
            <text x="880" y="86" text-anchor="middle" fill="#7d8798" font-size="10.5">sous le même contrôle</text>
            <rect x="820" y="236" width="120" height="52" rx="10" fill="#ffffff" stroke="#b9c2d0" stroke-dasharray="4 4"/>
            <text x="880" y="258" text-anchor="middle" fill="#182338">Supervision</text>
            <text x="880" y="276" text-anchor="middle" fill="#7d8798" font-size="10.5">audit · SIEM</text>
          </g>
          <text x="28" y="352" fill="#7d8798" font-size="11">Chaque requête, quel que soit l'outil, passe par le contrôle d'accès appliqué au moteur.</text>
        </svg>
      </div>
      <div class="legend">
        <span><i style="background:var(--violet)"></i>Moteur · calcul</span>
        <span><i style="background:var(--cyan)"></i>Stockage · lakehouse</span>
        <span><i style="background:var(--amber)"></i>Gouvernance</span>
        <span><i style="background:linear-gradient(90deg,var(--violet),var(--cyan))"></i>IA gouvernée</span>
        <span><i style="background:var(--green)"></i>Restitution · lab</span>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <p class="kicker" style="color:var(--green)">AKKO en action</p>
      <h2>La preuve par le produit.</h2>
      <div class="gallery">
        <figure><Shot src="aden-explain" alt="ADEN explique son raisonnement étape par étape" />
          <figcaption>ADEN explique chaque réponse : étapes, SQL, confiance.</figcaption></figure>
        <figure><Shot src="lineage" alt="Lignage des données dans le catalogue AKKO" />
          <figcaption>Le lignage suit la donnée, de la source au tableau de bord.</figcaption></figure>
        <figure><Shot src="monitoring-supervision" alt="Supervision de la plateforme AKKO" />
          <figcaption>Supervision de bout en bout, exportable vers votre SIEM.</figcaption></figure>
      </div>
    </div>
  </section>

  <section style="padding-top:0">
    <div class="wrap">
      <p class="kicker" style="color:var(--muted)">Blog</p>
      <h2>Ce que nous apprenons en construisant AKKO.</h2>
      <div class="posts">
        {posts.map((p) => (
          <a class="post" href={`/blog/${p.id}/`}>
            <span class="cat" style={`color:${catColors[p.data.category]}`}>{p.data.category}</span>
            <h3>{p.data.title}</h3>
            <time datetime={p.data.date.toISOString().slice(0, 10)}>
              {fmt(p.data.date)} · {p.data.minutes} min
            </time>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="final" id="contact">
    <div class="wrap">
      <h2>Parlons de votre plateforme souveraine.</h2>
      <p>Une démo sur votre cas d'usage, ou un échange technique.</p>
      <a class="btn" href="mailto:contact@akko-ai.com">Nous contacter</a>
      <a class="btn ghost" href="https://demo.akko-ai.com" style="margin-left:12px">Voir une démo</a>
    </div>
  </section>
</Base>

<style>
.hero{padding:104px 0 72px;position:relative;overflow:hidden}
.hero::before{content:"";position:absolute;inset:-40% -10% auto;height:120%;pointer-events:none;
  background:radial-gradient(52% 42% at 68% 30%,rgba(79,70,229,.06),transparent 70%)}
.hero .wrap{position:relative;display:grid;grid-template-columns:1.05fr .95fr;gap:56px;align-items:center}
.eyebrow{font-family:var(--mono);font-size:12.5px;letter-spacing:.22em;color:var(--faint);
  text-transform:uppercase;margin-bottom:22px}
h1{font-size:clamp(34px,4.6vw,52px);line-height:1.12;font-weight:640;letter-spacing:-.022em}
h1 em{font-style:normal;color:var(--violet)}
.hero p.sub{margin:24px 0 10px;font-size:18px;color:var(--muted);max-width:34em}
.hero p.ctx{font-size:14.5px;color:var(--faint)}
.hero .cta{display:flex;gap:14px;margin-top:34px}
.perimeter{position:relative;border:1.5px dashed rgba(79,70,229,.45);border-radius:16px;padding:14px}
.plabel{position:absolute;top:-9px;left:20px;background:var(--bg);padding:0 9px;
  font-family:var(--mono);font-size:10.5px;letter-spacing:.2em;text-transform:uppercase;color:var(--violet)}
.pnote{margin:11px 2px 0;font-family:var(--mono);font-size:11.5px;color:var(--faint)}
.facts{border-block:1px solid var(--line);padding:18px 0}
.facts ul{display:flex;flex-wrap:wrap;gap:10px 0;list-style:none}
.facts li{font-family:var(--mono);font-size:13px;color:var(--muted);display:flex;align-items:center}
.facts li + li::before{content:"";display:inline-block;width:1px;height:14px;background:var(--line);margin:0 22px}
.stack{padding:44px 0 40px}
.slabel{font-family:var(--mono);font-size:11.5px;letter-spacing:.18em;text-transform:uppercase;
  color:var(--faint);text-align:center;margin-bottom:26px}
.logos{list-style:none;display:flex;flex-wrap:wrap;justify-content:center;gap:18px 40px;padding:0}
.logos li{display:flex;align-items:center;gap:9px;opacity:.72;transition:opacity .15s}
.logos li:hover{opacity:1}
.logos span{font-size:13.5px;font-weight:530;color:var(--muted)}
.statement{border-top:1px solid var(--line)}
.statement h2{max-width:26em;font-size:clamp(27px,3.4vw,38px)}
.statement .body{font-size:17px;max-width:44em}
.diagram-sec{border-block:1px solid var(--line);background:
  radial-gradient(60% 80% at 50% 0%,rgba(79,70,229,.04),transparent 70%)}
.diagram-sec h2{max-width:none}
.diagram{margin-top:44px;border:1px solid var(--line);border-radius:14px;background:var(--surface);
  padding:28px;overflow-x:auto}
.diagram svg :global(text){font-family:var(--mono)}
.legend{display:flex;flex-wrap:wrap;gap:20px;margin-top:20px;font-family:var(--mono);font-size:12px;color:var(--muted)}
.legend i{display:inline-block;width:9px;height:9px;border-radius:2px;margin-right:7px;vertical-align:-1px}
.gallery{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:40px}
.gallery figure{margin:0}
.gallery figcaption{font-size:13.5px;color:var(--faint);margin-top:10px}
.posts{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:36px}
.post{border:1px solid var(--line);border-radius:12px;padding:24px;background:var(--surface);
  display:flex;flex-direction:column;gap:12px;transition:border-color .15s}
.post:hover{border-color:rgba(24,35,56,.3)}
.post .cat{font-family:var(--mono);font-size:11.5px;letter-spacing:.14em;text-transform:uppercase}
.post h3{font-size:17.5px;font-weight:590;line-height:1.35}
.post time{font-family:var(--mono);font-size:12px;color:var(--faint);margin-top:auto}
@media(max-width:900px){
  .hero .wrap,.gallery,.posts{grid-template-columns:1fr}
  .hero{padding-top:64px}
}
</style>
